# Copy to .env for local runs. In CI, set the first three as GitHub Actions secrets.

# HTTPS URL of catalog.json
PATCHVAULT_CATALOG_URL=
# HTTPS URL of the detached signature of catalog.json
PATCHVAULT_SIGNATURE_URL=
# P-256 public key: the base64 body of a PEM file on a single line
PATCHVAULT_PUBLIC_KEY=
